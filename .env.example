# Copy to .env.local for local work. Never commit real values.
# In Vercel set these under Settings > Environment Variables (Production and Preview; mark the key Sensitive).

# Required for generating. Only api/sample.js reads it.
ANTHROPIC_API_KEY=

# Optional. Defaults shown.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MAX_TOKENS=16000
